---
import { translations } from "../i18n/translations";
import { images } from "../data/images";
import CTAButton from "../components/CTAButton.astro";
import Icon from "../components/Icon.astro";

const t = translations.it as any;
---

<section
  id="home"
  class="relative isolate overflow-hidden bg-ocean-950 text-white"
>
  <!-- Background photo (PLACEHOLDER — replace via src/data/images.ts) -->
  <img
    src={images.heroPool}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    referrerpolicy="no-referrer"
  />
  <!-- Gradient overlay for text contrast -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-ocean-950/92 via-ocean-950/80 to-ocean-800/55"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <div class="max-w-3xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-medium backdrop-blur"
        data-reveal
      >
        <Icon name="sparkles" class="h-4 w-4 text-leaf-300" />
        <span data-i18n="hero.badge">{t.hero.badge}</span>
      </span>

      <h1
        class="mt-6 font-display text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
        data-reveal
        data-reveal-delay="1"
      >
        <span data-i18n="hero.titlePre">{t.hero.titlePre}</span>
        <span class="mt-1 block bg-gradient-to-r from-ocean-200 to-leaf-300 bg-clip-text text-transparent">
          <span data-i18n="hero.titleHighlight">{t.hero.titleHighlight}</span>
        </span>
      </h1>

      <p
        class="mt-6 max-w-xl text-base leading-relaxed text-ocean-50/90 sm:text-lg lg:text-xl"
        data-reveal
        data-reveal-delay="2"
        data-i18n="hero.subtitle"
      >
        {t.hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap gap-4" data-reveal data-reveal-delay="3">
        <CTAButton href="#contatti" variant="primary" size="lg">
          <span data-i18n="hero.ctaPrimary">{t.hero.ctaPrimary}</span>
          <Icon name="arrowRight" class="h-5 w-5" />
        </CTAButton>
        <CTAButton href="#servizi" variant="white" size="lg">
          <span data-i18n="hero.ctaSecondary">{t.hero.ctaSecondary}</span>
        </CTAButton>
      </div>

      <!-- Stats (animated count-up, see public/js/main.js) -->
      <dl
        class="mt-14 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-8 border-t border-white/15 pt-10 sm:grid-cols-4 sm:gap-x-8"
        data-reveal
        data-reveal-delay="4"
      >
        {
          t.hero.stats.map((s: any, i: number) => (
            <div>
              <dt
                class="font-display text-3xl font-extrabold text-white sm:text-4xl"
                data-countup
                data-i18n={`hero.stats.${i}.value`}
              >
                {s.value}
              </dt>
              <dd
                class="mt-1 text-xs font-medium text-ocean-100/80 sm:text-sm"
                data-i18n={`hero.stats.${i}.label`}
              >
                {s.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Decorative wave divider -->
  <div class="wave-divider absolute inset-x-0 bottom-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="h-10 w-full sm:h-16">
      <path d="M0 40c180-30 360-30 540 0s360 30 540 5 360-35 360-35V80H0V40z" fill="white" />
    </svg>
  </div>
</section>
