---
import { translations } from "../i18n/translations";
import { images } from "../data/images";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";

const t = translations.it as any;
const items = images.gallery.map((src, i) => ({
  src,
  captionKey: `gallery.captions.${i}`,
  caption: t.gallery.captions[i],
  featured: i === 0,
}));
---

<section id="progetti" class="scroll-mt-24 bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrowKey="gallery.eyebrow"
      titleKey="gallery.title"
      subtitleKey="gallery.subtitle"
      data-reveal
    />

    <div
      class="mt-14 grid auto-rows-[160px] grid-cols-1 gap-4 sm:auto-rows-[200px] sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        items.map((it, i) => (
          <button
            type="button"
            data-lightbox-trigger
            data-full={it.src}
            data-alt={it.caption}
            class={`group relative block overflow-hidden rounded-2xl bg-ocean-100 shadow-sm ring-1 ring-slate-200 focus-visible:outline-none ${
              it.featured ? "sm:col-span-2 sm:row-span-2" : ""
            }`}
            aria-label={it.caption}
            data-reveal
            data-reveal-delay={String(((i % 3) + 1))}
          >
            <img
              src={it.src}
              alt={it.caption}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <span class="absolute inset-0 bg-gradient-to-t from-ocean-950/75 via-ocean-950/10 to-transparent" />
            <span class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 p-4 text-left">
              <span
                class={`text-sm font-semibold text-white ${it.featured ? "sm:text-base" : ""}`}
                data-i18n={it.captionKey}
              >
                {it.caption}
              </span>
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur transition group-hover:bg-white/30">
                <Icon name="arrowRight" class="h-4 w-4 -rotate-45" />
              </span>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>
