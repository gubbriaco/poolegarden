---
import { translations } from "../i18n/translations";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";

const t = translations.it as any;

const cards = [
  { id: "piscine", icon: "pool", accent: "ocean", to: "#piscine" },
  { id: "irrigazione", icon: "droplet", accent: "ocean", to: "#irrigazione" },
  { id: "prati", icon: "leaf", accent: "leaf", to: "#prati" },
] as const;

const chipColor = {
  ocean: "bg-ocean-100 text-ocean-700 group-hover:bg-ocean-600 group-hover:text-white",
  leaf: "bg-leaf-100 text-leaf-700 group-hover:bg-leaf-600 group-hover:text-white",
};
---

<section id="servizi" class="scroll-mt-24 bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrowKey="servicesOverview.eyebrow"
      titleKey="servicesOverview.title"
      subtitleKey="servicesOverview.subtitle"
      data-reveal
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        cards.map((c, i) => (
          <a
            href={c.to}
            class="group relative flex flex-col rounded-3xl border border-slate-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-ocean-200 hover:shadow-xl"
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            <span
              class={`inline-flex h-14 w-14 items-center justify-center rounded-2xl transition-colors ${chipColor[c.accent]}`}
            >
              <Icon name={c.icon} class="h-7 w-7" />
            </span>
            <h3
              class="mt-6 text-xl font-bold text-ocean-950"
              data-i18n={`servicesOverview.cards.${c.id}.title`}
            >
              {t.servicesOverview.cards[c.id].title}
            </h3>
            <p
              class="mt-3 flex-1 leading-relaxed text-slate-600"
              data-i18n={`servicesOverview.cards.${c.id}.desc`}
            >
              {t.servicesOverview.cards[c.id].desc}
            </p>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-ocean-600">
              <span data-i18n="servicesOverview.learnMore">
                {t.servicesOverview.learnMore}
              </span>
              <Icon
                name="arrowRight"
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
