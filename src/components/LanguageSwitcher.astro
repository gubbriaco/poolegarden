---
/**
 * Segmented IT / EN language switcher.
 * Clicking a button dispatches the language change via public/js/i18n.js.
 * Default (IT) is marked active in markup; the script corrects it on load
 * according to the saved preference.
 */
---

<div
  class="inline-flex items-center rounded-full border border-ocean-100 bg-white/80 p-0.5 text-sm font-semibold"
  role="group"
  aria-label="Language switcher"
  data-i18n-attr="aria-label:lang.label"
>
  <button
    type="button"
    data-lang-btn="it"
    aria-pressed="true"
    class="lang-btn rounded-full px-2.5 py-1 text-ocean-700 transition"
  >
    IT
  </button>
  <button
    type="button"
    data-lang-btn="en"
    aria-pressed="false"
    class="lang-btn rounded-full px-2.5 py-1 text-ocean-700 transition"
  >
    EN
  </button>
</div>
