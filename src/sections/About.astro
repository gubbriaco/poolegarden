---
import { translations } from "../i18n/translations";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import CTAButton from "../components/CTAButton.astro";

const t = translations.it as any;

// icons for each value (quality / transparency / sustainability)
const valueIcons = ["shield", "sparkles", "leaf"];
---

<section id="chi-siamo" class="scroll-mt-24 bg-sand-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-16">
      <!-- Left: story -->
      <div data-reveal>
        <span
          class="inline-block text-sm font-bold uppercase tracking-wider text-ocean-600"
          data-i18n="about.eyebrow"
        >
          {t.about.eyebrow}
        </span>
        <h2
          class="mt-3 font-display text-3xl font-extrabold text-ocean-950 sm:text-4xl"
          data-i18n="about.title"
        >
          {t.about.title}
        </h2>
        <div class="mt-5 space-y-4 text-lg leading-relaxed text-slate-600">
          <p data-i18n="about.p1">{t.about.p1}</p>
          <p data-i18n="about.p2">{t.about.p2}</p>
        </div>

        <!-- Mission card -->
        <div class="mt-8 rounded-2xl border border-ocean-100 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2 text-ocean-700">
            <Icon name="target" class="h-5 w-5" />
            <h3 class="text-base font-bold" data-i18n="about.missionTitle">
              {t.about.missionTitle}
            </h3>
          </div>
          <p class="mt-2 leading-relaxed text-slate-600" data-i18n="about.missionText">
            {t.about.missionText}
          </p>
        </div>

        <div class="mt-8">
          <CTAButton href="#contatti" variant="primary" size="lg">
            <span data-i18n="nav.quote">{t.nav.quote}</span>
          </CTAButton>
        </div>
      </div>

      <!-- Right: values + why choose us -->
      <div class="space-y-8" data-reveal data-reveal-delay="2">
        <!-- Values -->
        <div>
          <h3 class="text-lg font-bold text-ocean-950" data-i18n="about.valuesTitle">
            {t.about.valuesTitle}
          </h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {
              t.about.values.map((v: any, i: number) => (
                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-ocean-50 text-ocean-600">
                    <Icon name={valueIcons[i] ?? "checkCircle"} class="h-5 w-5" />
                  </span>
                  <h4
                    class="mt-3 text-sm font-bold text-ocean-950"
                    data-i18n={`about.values.${i}.title`}
                  >
                    {v.title}
                  </h4>
                  <p
                    class="mt-1 text-sm leading-relaxed text-slate-600"
                    data-i18n={`about.values.${i}.desc`}
                  >
                    {v.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Why choose us -->
        <div class="rounded-2xl bg-ocean-950 p-7 text-white">
          <h3 class="text-lg font-bold text-white" data-i18n="about.whyTitle">
            {t.about.whyTitle}
          </h3>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              t.about.why.map((w: string, i: number) => (
                <li class="flex items-start gap-2.5 text-sm text-ocean-50/90">
                  <Icon name="checkCircle" class="mt-0.5 h-5 w-5 shrink-0 text-leaf-400" />
                  <span data-i18n={`about.why.${i}`}>{w}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
