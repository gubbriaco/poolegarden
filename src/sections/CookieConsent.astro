---
import { translations } from "../i18n/translations";
const t = translations.it as any;
---

<aside
  data-cookie-banner
  class="fixed inset-x-0 bottom-0 z-[110] hidden p-4 sm:p-6"
  role="dialog"
  aria-modal="false"
  aria-label={t.cookie.title}
  data-i18n-attr="aria-label:cookie.title"
>
  <div
    class="mx-auto flex max-w-4xl flex-col items-start gap-4 rounded-2xl border border-ocean-100 bg-white p-5 shadow-2xl sm:flex-row sm:items-center"
  >
    <div class="flex-1">
      <h2 class="text-sm font-bold text-ocean-950" data-i18n="cookie.title">
        {t.cookie.title}
      </h2>
      <p class="mt-1 text-xs leading-relaxed text-slate-600">
        <span data-i18n="cookie.text">{t.cookie.text}</span>
        <a href="/cookie-policy" class="font-semibold text-ocean-600 hover:underline" data-i18n="cookie.link">
          {t.cookie.link}
        </a>
      </p>
    </div>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-cookie-reject
        class="rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50"
        data-i18n="cookie.reject"
      >
        {t.cookie.reject}
      </button>
      <button
        type="button"
        data-cookie-accept
        class="rounded-full bg-ocean-600 px-4 py-2 text-xs font-semibold text-white shadow-sm transition hover:bg-ocean-700"
        data-i18n="cookie.accept"
      >
        {t.cookie.accept}
      </button>
    </div>
  </div>
</aside>
