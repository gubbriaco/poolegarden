---
import { translations } from "../i18n/translations";
import { site } from "../data/site";
import Icon from "../components/Icon.astro";

const t = translations.it as any;
---

<section class="bg-white py-12 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-ocean-700 via-ocean-800 to-leaf-700 px-6 py-12 text-white shadow-xl sm:px-12"
      data-reveal
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/10 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-leaf-400/20 blur-2xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative grid items-center gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-extrabold sm:text-3xl" data-i18n="newsletter.title">
            {t.newsletter.title}
          </h2>
          <p class="mt-2 text-ocean-50/90" data-i18n="newsletter.subtitle">
            {t.newsletter.subtitle}
          </p>
        </div>

        <form
          action={site.forms.newsletter}
          method="POST"
          data-ajax-form
          data-success={t.newsletter.success}
          data-error={t.contact.form.error}
          class="w-full"
        >
          <div class="flex flex-col gap-3 sm:flex-row">
            <label for="nl-email" class="sr-only" data-i18n="newsletter.placeholder">
              {t.newsletter.placeholder}
            </label>
            <input
              id="nl-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full rounded-full border border-white/20 bg-white/95 px-5 py-3 text-sm text-ocean-950 outline-none transition placeholder:text-slate-400 focus:ring-2 focus:ring-white"
              data-i18n-attr="placeholder:newsletter.placeholder"
              placeholder={t.newsletter.placeholder}
            />
            <button
              type="submit"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-leaf-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-leaf-900/20 transition hover:-translate-y-0.5 hover:bg-leaf-600"
            >
              <span data-i18n="newsletter.button">{t.newsletter.button}</span>
              <Icon name="arrowRight" class="h-4 w-4" />
            </button>
          </div>
          <p class="mt-3 text-xs text-ocean-50/70" data-i18n="newsletter.disclaimer">
            {t.newsletter.disclaimer}
          </p>
          <p data-form-status class="mt-2 hidden text-sm font-medium text-white" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>
