---
/**
 * Reusable section heading: eyebrow + title + optional subtitle, centered.
 * All text comes from i18n via data-i18n keys.
 */
interface Props {
  eyebrowKey?: string;
  titleKey?: string;
  subtitleKey?: string;
  align?: "center" | "left";
  class?: string;
  light?: boolean;
}
const {
  eyebrowKey,
  titleKey,
  subtitleKey,
  align = "center",
  class: className = "",
  light = false,
} = Astro.props;

const alignCls = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`max-w-2xl ${alignCls} ${className}`}>
  {
    eyebrowKey && (
      <span
        class={`inline-block text-sm font-bold uppercase tracking-wider ${
          light ? "text-ocean-100" : "text-ocean-600"
        }`}
        data-i18n={eyebrowKey}
      >
        eyebrow
      </span>
    )
  }
  {
    titleKey && (
      <h2
        class={`mt-3 font-display text-3xl font-extrabold sm:text-4xl ${
          light ? "text-white" : "text-ocean-950"
        }`}
        data-i18n={titleKey}
      >
        Title
      </h2>
    )
  }
  {
    subtitleKey && (
      <p
        class={`mt-4 text-lg leading-relaxed ${
          light ? "text-ocean-50" : "text-slate-600"
        }`}
        data-i18n={subtitleKey}
      >
        Subtitle
      </p>
    )
  }
</div>
