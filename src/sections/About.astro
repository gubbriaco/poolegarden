---
import { translations } from "../i18n/translations";
import { images } from "../data/images";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import CTAButton from "../components/CTAButton.astro";

const t = translations.it as any;

// icons for each value (quality / transparency / sustainability)
const valueIcons = ["shield", "sparkles", "leaf"];
---

<section id="chi-siamo" class="scroll-mt-24 bg-sand-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrowKey="about.eyebrow"
      titleKey="about.title"
      data-reveal
    />

    <!-- Story + image -->
    <div class="mt-14 grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Image -->
      <div class="relative" data-reveal>
        <button
          type="button"
          data-lightbox-trigger
          data-full={images.about}
          data-alt={t.about.title}
          aria-label={t.about.title}
          class="group relative block aspect-[4/3] w-full overflow-hidden rounded-3xl shadow-xl ring-1 ring-ocean-100 focus-visible:outline-none"
        >
          <img
            src={images.about}
            alt={t.about.title}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ocean-950/30 to-transparent"></div>
          <span class="absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-ocean-700 opacity-0 shadow-lg backdrop-blur transition-opacity duration-300 group-hover:opacity-100">
            <Icon name="maximize" class="h-4 w-4" />
          </span>
        </button>
        <!-- Floating experience badge -->
        <div class="absolute -bottom-6 -right-3 flex items-center gap-3 rounded-2xl bg-white p-4 shadow-xl ring-1 ring-ocean-100 sm:-right-6">
          <span
            class="font-display text-3xl font-extrabold text-ocean-600"
            data-countup
            data-i18n="hero.stats.0.value">20+</span
          >
          <span class="text-xs font-medium leading-tight text-slate-500" data-i18n="hero.stats.0.label">
            {t.hero.stats[0].label}
          </span>
        </div>
      </div>

      <!-- Text -->
      <div data-reveal data-reveal-delay="2">
        <div class="space-y-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          <p data-i18n="about.p1">{t.about.p1}</p>
          <p data-i18n="about.p2">{t.about.p2}</p>
        </div>

        <!-- Mission card -->
        <div class="mt-7 rounded-2xl border border-ocean-100 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2 text-ocean-700">
            <Icon name="target" class="h-5 w-5" />
            <h3 class="text-base font-bold" data-i18n="about.missionTitle">
              {t.about.missionTitle}
            </h3>
          </div>
          <p class="mt-2 leading-relaxed text-slate-600" data-i18n="about.missionText">
            {t.about.missionText}
          </p>
        </div>

        <div class="mt-7">
          <CTAButton href="#contatti" variant="primary" size="lg">
            <span data-i18n="nav.quote">{t.nav.quote}</span>
            <Icon name="arrowRight" class="h-5 w-5" />
          </CTAButton>
        </div>
      </div>
    </div>

    <!-- Values -->
    <div class="mt-20">
      <h3 class="text-center text-lg font-bold text-ocean-950" data-i18n="about.valuesTitle">
        {t.about.valuesTitle}
      </h3>
      <div class="mx-auto mt-6 grid max-w-4xl gap-4 sm:grid-cols-3">
        {
          t.about.values.map((v: any, i: number) => (
            <div
              class="rounded-2xl border border-slate-100 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md"
              data-reveal
              data-reveal-delay={String(i + 1)}
            >
              <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-xl bg-ocean-50 text-ocean-600">
                <Icon name={valueIcons[i] ?? "checkCircle"} class="h-6 w-6" />
              </span>
              <h4
                class="mt-4 text-base font-bold text-ocean-950"
                data-i18n={`about.values.${i}.title`}
              >
                {v.title}
              </h4>
              <p
                class="mt-2 text-sm leading-relaxed text-slate-600"
                data-i18n={`about.values.${i}.desc`}
              >
                {v.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Why choose us -->
    <div
      class="relative mt-12 overflow-hidden rounded-3xl bg-ocean-950 p-8 text-white sm:p-12"
      data-reveal
    >
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-ocean-500/20 blur-2xl"></div>
      <div class="relative">
        <h3 class="text-xl font-bold text-white sm:text-2xl" data-i18n="about.whyTitle">
          {t.about.whyTitle}
        </h3>
        <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            t.about.why.map((w: string, i: number) => (
              <li class="flex items-start gap-2.5 text-sm text-ocean-50/90">
                <Icon name="checkCircle" class="mt-0.5 h-5 w-5 shrink-0 text-leaf-400" />
                <span data-i18n={`about.why.${i}`}>{w}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
